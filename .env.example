# Example environment for local builds. Copy to .env.local (git-ignored) and fill in.
# Never put values in this file: it is committed and the repo is public.
#
# Everything prefixed NEXT_PUBLIC_ is PUBLIC. Next.js inlines it into the JavaScript
# that every visitor downloads. Only values that are safe to publish may go here.
# Never put a real secret (GitHub token, API secret, password) in a NEXT_PUBLIC_ variable.
#
# In production these come from GitHub repository *variables* (Settings > Secrets and
# variables > Actions > Variables): CONTACT_ENDPOINT and CONTACT_ACCESS_KEY, mapped in
# .github/workflows/deploy.yml. See docs/runbooks/contact-form.md.
#
# If either is empty, the contact form shows its "not configured" state with the
# email fallback, and the build still succeeds.

# Contact form endpoint, e.g. the Web3Forms submit URL. Must be https://.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Contact form access key from the Web3Forms dashboard (public by design).
NEXT_PUBLIC_CONTACT_ACCESS_KEY=

# Optional, local/QA only: include drafts and future-dated posts (pnpm build:drafts sets it).
# Never set this in deploy.yml.
# BLOG_INCLUDE_DRAFTS=1
